{
  "opencollection": "1.0.0",
  "info": {
    "name": "ACA-Py Admin Basicmessages Forward API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Forward",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List forward messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{host}:{port}/forward"
          },
          "docs": "Returns forward message delivery records. Requires the agent to be run with --monitor-forward."
        }
      ]
    }
  ],
  "bundled": true
}
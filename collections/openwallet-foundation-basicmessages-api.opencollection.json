{
  "opencollection": "1.0.0",
  "info": {
    "name": "ACA-Py Admin Basicmessages API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Basicmessages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List basic messages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://{host}:{port}/basicmessages"
          },
          "docs": "Returns basic messages received by the agent."
        }
      ]
    }
  ],
  "bundled": true
}